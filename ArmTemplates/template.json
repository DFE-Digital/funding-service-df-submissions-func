{
    "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
        "environmentTag": {
            "type": "string"
        },
        "parentBusinessTag": {
            "type": "string"
        },
        "portfolioTag": {
            "type": "string"
        },
        "productTag": {
            "type": "string"
        },
        "serviceTag": {
            "type": "string"
        },
        "serviceLineTag": {
            "type": "string"
        },
        "serviceOfferingTag": {
            "type": "string"
        },
        "sharedVirtualNetworkName": {
            "type": "string",
            "metadata": {
                "description": "The name of the shared virtual network"
            }
        },
        "sharedResourceGroupName": {
            "type": "string",
            "metadata": {
                "description": "the name of the shared resource group"
            }
        },
        "funcsSubnetName": {
            "type": "string",
            "metadata": {
                "description": "The name of the shared subnet on the shared network to attached the app service to"
            }
        },
        "sharedLogAnalyticsName": {
            "type": "string",
            "metadata": {
                "description": "The name of the shared log analytics account"
            }
        },
        "sharedAppInsightsName": {
            "type": "string",
            "metadata": {
                "description": "The name of the shared app insights account"
            }
        },
        "sharedKeyVaultName": {
            "type": "string",
            "metadata": {
                "description": "The name of the shared key vault"
            }
        },
        "sharedLinuxFunctionAppServicePlanName": {
            "type": "string",
            "metadata": {
                "description": "The name of the linux hosting plan to host the api on"
            }
        },
        "dfSubmissionLinuxFunctionAppName": {
            "type": "string",
            "metadata": {
                "description": "The name of for the linux app service"
            }
        }
    },
    "variables": {
        "fundingBuildingBlocksUrl": "https://raw.githubusercontent.com/SkillsFundingAgency/funding-platform-building-blocks/digitalForms/templates/"
    },
    "resources": [
        {
            "type": "Microsoft.Resources/deployments",
            "apiVersion": "2018-05-01",
            "name": "dfSubmissionLinuxFunctionApp",
            "properties": {
                "mode": "Incremental",
                "templateLink": {
                    "uri": "[concat(variables('fundingBuildingBlocksUrl'),'function-app.json')]",
                    "contentVersion": "1.0.0.0"
                },
                "parameters": {
                    "environmentTag": {
                        "value": "[parameters('environmentTag')]"
                    },
                    "parentBusinessTag": {
                        "value": "[parameters('parentBusinessTag')]"
                    },
                    "portfolioTag": {
                        "value": "[parameters('portfolioTag')]"
                    },
                    "productTag": {
                        "value": "[parameters('productTag')]"
                    },
                    "serviceTag": {
                        "value": "[parameters('serviceTag')]"
                    },
                    "serviceLineTag": {
                        "value": "[parameters('serviceLineTag')]"
                    },
                    "serviceOfferingTag": {
                        "value": "[parameters('serviceOfferingTag')]"
                    },
                    "functionAppName": {
                        "value": "[parameters('dfSubmissionLinuxFunctionAppName')]"
                    },
                    "appServicePlanName": {
                        "value": "[parameters('sharedLinuxFunctionAppServicePlanName')]"
                    },
                    "appServicePlanResourceGroup": {
                        "value": "[parameters('sharedResourceGroupName')]"
                    },
                    "functionAppAppSettings": {
                        "value": [
                            {
                                "name": "APPLICATIONINSIGHTS_CONNECTION_STRING",
                                "value": "[reference(resourceId(parameters('sharedResourceGroupName'), 'Microsoft.Insights/components/', parameters('sharedAppInsightsName')), '2020-02-02-preview').ConnectionString]"
                            },
                            {
                                "name": "AzureWebJobsStorage",
                                "value": "[concat('@Microsoft.KeyVault(VaultName=', parameters('sharedKeyVaultName'),';SecretName=AzureStorageConnectionString)')]"
                            },
                            {
                                "name": "WEBSITE_TIME_ZONE",
                                "value": "GMT Standard Time"
                            },
                            {
                                "name": "WEBSITE_RUN_FROM_PACKAGE",
                                "value": "1"
                            },
                            {
                                "name": "APPINSIGHTS_INSTRUMENTATIONKEY",
                                "value": "[reference(resourceId(parameters('sharedResourceGroupName'), 'Microsoft.Insights/components/', parameters('sharedAppInsightsName')), '2020-02-02-preview').InstrumentationKey]"
                            },
                            {
                                "name": "FUNCTIONS_EXTENSION_VERSION",
                                "value": "~4"
                            },
                            {
                                "name": "FUNCTIONS_WORKER_RUNTIME",
                                "value": "dotnet-isolated"
                            },
                            {
                                "name": "PDFPrintQName",
                                "value": "dfsubmissions-pdfprintq"
                            },
                            {
                                "name": "DataQName",
                                "value": "dfsubmissions-dataq"
                            },

                            {
                                "name": "ServiceBusConnection",
                                "value": "[concat('@Microsoft.KeyVault(VaultName=', parameters('sharedKeyVaultName'),';SecretName=ServiceBusConnectionString)')]"
                            },
                            {
                                "name": "WarningimgPath",
                                "value": "warning.png"
                            },
                            {
                                "name": "DFSQLAPIKEY",
                                "value": "[concat('@Microsoft.KeyVault(VaultName=', parameters('sharedKeyVaultName'),';SecretName=DFSQLAPIKEY)')]"
                            },
                            {
                                "name": "DFSQLAPIURL",
                                "value": "[concat('@Microsoft.KeyVault(VaultName=', parameters('sharedKeyVaultName'),';SecretName=DFSQLAPIURL)')]"
                            }
                        ]
                    },
                    "http20Enabled": {
                        "value": true
                    },
                    "subnetResourceId": {
                        "value": "[resourceId(parameters('sharedResourceGroupName') , 'Microsoft.Network/virtualNetworks/subnets', parameters('sharedVirtualNetworkName'), parameters('funcsSubnetName'))]"
                    },
                    "workspaceId": {
                        "value": "[resourceId(parameters('sharedResourceGroupName') , 'microsoft.operationalinsights/workspaces', parameters('sharedLogAnalyticsName'))]"
                    },
                    "functionAppLogsSetting": {
                        "value": true
                    },
                    "retentionPolicyEnabled": {
                        "value": false
                    },
                    "netFrameworkVersion": {
                        "value": "v8.0"
                    }
                }
            }
        },
        {
            "apiVersion": "2019-07-01",
            "name": "dfSubmissionFunctionAppPolicy",
            "resourceGroup": "[parameters('sharedResourceGroupName')]",
            "type": "Microsoft.Resources/deployments",
            "dependsOn": [
                "dfSubmissionLinuxFunctionApp"
            ],
            "properties": {
                "mode": "Incremental",
                "templateLink": {
                "uri": "[concat(variables('fundingBuildingBlocksUrl'),'keyvault-accesspolicies.json')]",
                "contentVersion": "1.0.0.0"
                },
                "parameters": {
                    "keyVaultName": {
                        "value": "[parameters('sharedKeyVaultName')]"
                    },
                    "accessPolicies": {
                        "value": [
                            {
                                "tenantId": "[subscription().tenantId]",
                                "objectId": "[reference('dfSubmissionLinuxFunctionApp', '2019-07-01').outputs.managedServiceIdentityId.value]",
                                "permissions": {
                                "secrets": ["list", "get"]
                                }
                            }
                        ]
                    }
                }
            }
        }
    ]
}
